# --- 核心模型接入 (Core LLM) ---
TA_API_KEY=your-api-key
TA_BASE_URL=https://api.openai.com/v1
TA_LLM_PROVIDER=openai

# 模型名配置 (默认已提供常用值)
TA_LLM_QUICK=gpt-4o-mini
TA_LLM_DEEP=gpt-4o

# --- 安全密钥 (Security) ---
# 用于加密用户 API Key 和签发 JWT，生产环境必须设置！
# 生成方式: openssl rand -base64 32
# 首次设置时，系统会自动将已有数据从默认密钥迁移到新密钥。
# TA_APP_SECRET_KEY=your-secret-key

# --- 进阶可选配置 (Advanced Optional) ---
# 提示词语言 (auto / zh / en)，默认 zh
# TA_LANGUAGE=zh

# 运行日志追踪 (1 开启 / 0 关闭)，默认 1
# TA_TRACE=1

# 辩论与风险讨论轮数 (1-5)，默认 1
# TA_MAX_DEBATE=1
# TA_MAX_RISK=1

# --- VLM 截图识别 (Vision Language Model) ---
# 用于持仓截图识别，默认使用智谱 glm-4.6v-flash（免费）
# TA_VLM_API_KEY=your-vlm-key
# TA_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TA_VLM_MODEL=glm-4.6v-flash

# --- 邮件服务 (Email/SMTP) ---
# 仅在需要开启邮箱验证码登录时配置
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USER=your-email@gmail.com
# MAIL_PASS=your-app-password
# MAIL_FROM=TradingAgents
# MAIL_SSL=1

# --- Futu OpenD API ---
# 用于获取 US/HK 市场数据（需运行 FutuOpenD 客户端）
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
# FUTU_RSA_KEY_PATH=config/rsa_key.txt

# --- 搜索引擎 (Search API) ---
# 可在前端设置页配置，也可在此处预设
# TAVILY_API_KEY=your-tavily-key
# SERPAPI_API_KEY=your-serpapi-key
# BOCHA_API_KEY=your-bocha-key

# --- 社交舆情 (Social Sentiment) ---
# 获取地址: https://api.adanos.org
# SOCIAL_SENTIMENT_API_KEY=your-adanos-key
# SOCIAL_SENTIMENT_BASE_URL=https://api.adanos.org
